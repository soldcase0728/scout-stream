# Scout Stream - Environment Variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Database (matches docker-compose.yml defaults)
SCOUT_DATABASE_URL=postgresql://scoutstream:scoutstream_dev@localhost:5432/scoutstream

# Redis (matches docker-compose.yml defaults)
SCOUT_REDIS_URL=redis://localhost:6379/0

# Auth
SCOUT_SECRET_KEY=dev-secret-key-change-in-production
SCOUT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage (relative to backend/ directory)
SCOUT_UPLOAD_DIR=./uploads
SCOUT_PROCESSED_DIR=./processed
